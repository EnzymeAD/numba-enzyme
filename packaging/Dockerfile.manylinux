# Custom cibuildwheel container image for numba-enzyme (Linux x86_64).
#
# UNVERIFIED AS WRITTEN: no docker/podman was available in the sandbox
# this was authored in, so this file has not been built or run. The
# vendoring mechanics it exists to support (auditwheel correctly
# repairing vendored *executables*, RPATH self-containment with zero
# system LLVM present) WERE independently verified via a manual spike
# outside Docker -- see the packaging plan / project memory for that.
# This Dockerfile needs a real `docker build` + cibuildwheel run to
# confirm before relying on it; expect to iterate.
#
# Mirrors the actual dev environment this package was built and proven
# in: Debian 13 (trixie) base, with LLVM 15 pulled from apt.llvm.org's
# "bookworm" channel (there is no llvm-15 channel for trixie itself;
# Debian's ABI is stable enough across this one release gap for
# bookworm's LLVM 15 .debs to work on trixie -- confirmed on the actual
# dev box, not assumed).

FROM debian:trixie

ENV DEBIAN_FRONTEND=noninteractive

# --- LLVM 15 (matches the proven dev-environment setup exactly), plus
#     cmake/build-essential/git/patchelf (patchelf is required by
#     auditwheel repair -- confirmed during the manual spike it is NOT
#     installed by default) and CPython's own build dependencies
#     (building 3.10/3.11/3.12/3.13 from source below, since trixie's apt
#     only ships 3.13 and cibuildwheel's custom-image contract requires
#     every target version pre-installed under /opt/python/, matching
#     the official manylinux image convention). ---
RUN apt-get update && apt-get install -y --no-install-recommends \
        curl gnupg ca-certificates \
    && curl -fsSL https://apt.llvm.org/llvm-snapshot.gpg.key \
        | gpg --dearmor -o /usr/share/keyrings/llvm-archive-keyring.gpg \
    && echo "deb [signed-by=/usr/share/keyrings/llvm-archive-keyring.gpg] http://apt.llvm.org/bookworm/ llvm-toolchain-bookworm-15 main" \
        > /etc/apt/sources.list.d/llvm-15.list \
    && apt-get update \
    && apt-get install -y --no-install-recommends \
        llvm-15-dev clang-15 lld-15 \
        cmake build-essential git patchelf \
        libssl-dev zlib1g-dev libbz2-dev libreadline-dev libsqlite3-dev \
        libffi-dev liblzma-dev tk-dev uuid-dev libncurses-dev \
    && rm -rf /var/lib/apt/lists/*

# lld-15 (LLVM's own linker) is vendored alongside clang, not relied on
# from the system: `clang -shared` still shells out to a SEPARATE
# linker executable for the final link step, and a bare-minimum target
# image (confirmed via a real smoke test on python:3.11-slim) has no
# system `ld`/binutils at all -- "clang: error: unable to execute
# command: Executable "ld" doesn't exist!". clang searches its own
# binary's directory for a linker named `ld.lld` when given
# `-fuse-ld=lld`, so vendoring it alongside clang (see
# cibw_before_all.sh) keeps the whole thing self-contained with no
# system linker dependency at all -- confirmed working with a fully
# stripped environment (env -i, no PATH/LD_LIBRARY_PATH pointing at any
# system LLVM) before wiring this in.

# Building LLVMEnzyme-15.so itself happens in CIBW_BEFORE_ALL
# (packaging/cibw_before_all.sh), not baked into this image -- keeps
# the pinned Enzyme release tag a build-time choice, not an
# image-rebuild-required one.

# --- Python interpreters, matching manylinux's /opt/python/<tag>-<tag>/
#     convention exactly -- cibuildwheel requires this layout for any
#     custom (non-pypa-maintained) image; it does not provision
#     interpreters into a container it doesn't control. Patch versions
#     current as of authoring; bump to latest as needed.
#
#     auditwheel and build are installed into EVERY interpreter here,
#     not just one: cibuildwheel's own docs say a custom image must
#     already have auditwheel present, and its container-build repair
#     step runs with the per-build interpreter's bin/ prepended to PATH
#     (cibuildwheel/platforms/linux.py) -- installing it against only
#     one interpreter and hoping PATH falls back to find it elsewhere
#     isn't something to bet on. `build` is the default build_frontend
#     cibuildwheel invokes as `python -m build` to actually build the
#     wheel -- confirmed missing in an earlier real run (ModuleNotFoundError). ---
ARG PY310_VERSION=3.10.19
ARG PY311_VERSION=3.11.15
ARG PY312_VERSION=3.12.13
ARG PY313_VERSION=3.13.14
# cibuildwheel 4.1.1 unconditionally hardcodes /opt/python/cp39-cp39/bin
# into PATH to run its own before_all housekeeping (an environment
# snapshot via `python -c 'import sys, json, os; ...'`) -- regardless
# of the actual build target selector (confirmed by reading
# cibuildwheel/platforms/linux.py directly; not documented anywhere).
# This interpreter never builds or tests an actual wheel, so it's built
# below without --enable-optimizations (skips an expensive PGO build
# that would only matter for a real workload) and without auditwheel.
ARG PY39_VERSION=3.9.25

RUN set -eux; \
    version="${PY39_VERSION}"; minor="${version%.*}"; tag="cp39-cp39"; \
    curl -fsSL "https://www.python.org/ftp/python/${version}/Python-${version}.tar.xz" -o /tmp/python.tar.xz; \
    mkdir -p /tmp/build && tar -xf /tmp/python.tar.xz -C /tmp/build; \
    ( cd "/tmp/build/Python-${version}" \
      && ./configure --prefix="/opt/python/${tag}" \
      && make -j"$(nproc)" \
      && make install ); \
    rm -rf /tmp/build /tmp/python.tar.xz; \
    ln -sf "python${minor}" "/opt/python/${tag}/bin/python"

RUN set -eux; \
    for spec in "cp310-cp310:${PY310_VERSION}" "cp311-cp311:${PY311_VERSION}" "cp312-cp312:${PY312_VERSION}" "cp313-cp313:${PY313_VERSION}"; do \
        tag="${spec%%:*}"; version="${spec##*:}"; minor="${version%.*}"; \
        curl -fsSL "https://www.python.org/ftp/python/${version}/Python-${version}.tar.xz" -o /tmp/python.tar.xz; \
        mkdir -p /tmp/build && tar -xf /tmp/python.tar.xz -C /tmp/build; \
        ( cd "/tmp/build/Python-${version}" \
          && ./configure --prefix="/opt/python/${tag}" --enable-optimizations --with-ensurepip=install \
          && make -j"$(nproc)" \
          && make install ); \
        rm -rf /tmp/build /tmp/python.tar.xz; \
        "/opt/python/${tag}/bin/python${minor}" -m pip install --no-cache-dir --upgrade pip auditwheel build; \
        ln -sf "python${minor}" "/opt/python/${tag}/bin/python"; \
        ln -sf "python${minor}" "/opt/python/${tag}/bin/python3"; \
    done

ENV PATH="/opt/python/cp313-cp313/bin:${PATH}"

# cibuildwheel/auditwheel cannot infer the manylinux compat tag for a
# custom (non-pypa) image on their own. This exact value was measured,
# not guessed: `auditwheel show` on binaries built precisely this way
# (Debian trixie base + apt.llvm.org bookworm LLVM 15 channel) during
# the manual spike reported "manylinux_2_39_x86_64" as the achievable
# tag. Re-verify if the base image or LLVM channel ever changes.
ENV AUDITWHEEL_PLAT=manylinux_2_39_x86_64
